---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import font400 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';

interface Props { title: string; description?: string }
const { title, description = 'PrepUSI — study notes, worked examples and interactive figures for the MSc Finance at USI.' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="color-scheme" content="dark light" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preload" href={font400} as="font" type="font/woff2" crossorigin />
</head>
<body>
<script is:inline>
/* apply saved theme before first paint to avoid a flash of dark mode */
(function () {
  try {
    var t = localStorage.getItem('prepusi-theme');
    if (t === 'light' || t === 'solar') document.body.classList.add(t);
  } catch (e) {}
})();
</script>
<slot />
<script>
  import '../scripts/theme.js';
</script>
</body>
</html>
