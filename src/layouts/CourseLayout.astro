---
// Shell for every course page: top bar, sidebar, footer.
//   view = 'overview' | 'topic' | 'all'
// The sidebar lists topics (group labels, linking to the topic page) and their
// modules. A module on the current page links to its anchor; any other module
// links to its topic page + anchor.
import Base from './Base.astro';

const { course, view, topic, title } = Astro.props;
const isAll = view === 'all';
const here = (m) => isAll || m.topic === topic;
const linkFor = (m) => (here(m) ? '#' + m.anchor : m.href);
const topicLink = (t) => (isAll ? '#' + t.modules[0].anchor : t.href);
---
<Base title={title ?? course.title} description={`${course.title} — ${course.stats}`}>

<div class="topbar">
  <button class="tog" id="sidebtn" title="toggle sidebar" aria-label="toggle sidebar">≡</button>
  <a class="brand" href={course.base + '/'}>{course.brand}</a>
  <span class="tag">{course.tag}</span>
  <span>{course.stats}</span>
  <div class="right">
    <a href={course.home ?? '/'} title="back to the course list">⌂ {course.homeLabel ?? 'courses'}</a>
    {isAll
      ? <a href={course.base + '/'} title="read one topic at a time">▤ by topic</a>
      : <a class="allbtn" href={course.allHref} title="every module on one page — for Ctrl+F and printing" data-astro-prefetch="false">≣ one page</a>}
    <button id="themebtn">◐ theme: dark</button>
    <button id="printbtn" title={isAll ? 'print the whole course' : 'print this page — use “one page” to print the whole course'}>⎙ print / PDF</button>
  </div>
</div>

<div class="layout">
<nav class="side" aria-label="modules">
  <a href={isAll ? '#top' : course.base + '/'} class:list={['ov', { active: view === 'overview' }]}>⌂ overview</a>
  {course.topics.map((t) => (
    <>
      <a href={topicLink(t)} class:list={['lbl part', { current: t === topic }]}>{t.name}</a>
      {t.modules.map((m) => (
        <a href={linkFor(m)}><span class="n">{m.num}</span>{m.title}</a>
      ))}
    </>
  ))}
  <div class="lbl" style="margin-top:14px">Legend</div>
  <div class="legend">
    <span class="pill g">DEF</span> definition<br />
    <span class="pill b">EX</span> worked example<br />
    <span class="pill a">TIP</span> exam shortcut<br />
    <span class="pill r">TRAP</span> common mistake
  </div>
</nav>

<main class="main" id="top" data-course={course.id} data-view={view}>
<slot />
<p class="muted foot">{course.footer}</p>
</main>
</div>

<script>
  import '../scripts/course.js';
</script>
</Base>
