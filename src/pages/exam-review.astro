---
import CourseLayout from '../layouts/CourseLayout.astro';
import course from '../courses/exam-review/meta.json';
import hero from '../courses/exam-review/hero.html?raw';

// module fragments are verbatim HTML, one file per module, rendered in filename order
const files = import.meta.glob('../courses/exam-review/modules/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const modulesHtml = Object.keys(files)
  .sort()
  .map((k) => files[k]);
---
<CourseLayout course={course}>
  <Fragment set:html={hero} />
  {modulesHtml.map((html) => <Fragment set:html={html} />)}
</CourseLayout>

<script>
  import '../courses/exam-review/interactive.js';
</script>
